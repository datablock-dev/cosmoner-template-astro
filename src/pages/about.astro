---
import Base from "../layouts/Base.astro";
---

<Base title="About">
  <h1>About</h1>
  <p>
    Every page of this site is generated when it is built. There is no server
    to run: the files in <code>dist/</code> are all there is.
  </p>
  <p>
    Pages live in <code>src/pages/</code>, posts in
    <code>src/content/posts/</code>, and anything in <code>public/</code> is
    copied as it is.
  </p>
</Base>
